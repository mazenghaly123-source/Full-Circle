// Cloudflare Workers with static assets and no Astro adapter (see
// docs/adr/0002-cloudflare-workers-static-assets.md). Keep this file: without it, `wrangler deploy`
// sets up an adapter and a Worker on its own. The one Worker, src/worker.ts, serves the pages'
// markdown versions (docs/adr/0006-a-worker-for-markdown.md) and runs only on the paths in
// `run_worker_first`; everything else is served straight from the assets.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "full-circle",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // the pages with a markdown version (src/md/registry.ts; tests/unit/md.spec.ts keeps the two
    // lists the same), their .md files, and /api/md/; and any path ending in / or .html, which the
    // Worker sends to the page's one address with a 301 (src/canonical.ts) instead of the assets' 307
    "run_worker_first": [
      "/", "/how-it-works", "/what-we-make", "/about", "/request-a-sample", "/track", "/contact", "/book-a-call", "/privacy",
      "/clothing-manufacturer-egypt", "/jeans-manufacturer-egypt", "/private-label-clothing", "/hoodie-manufacturer-egypt",
      "/*.md", "/api/md", "/api/md/*", "/*/", "/*.html"
    ]
  },
  // the live site: each `wrangler deploy` from main attaches these as Custom Domains (Cloudflare adds
  // their DNS records and certificates)
  "routes": [
    { "pattern": "fullcircle-co.com", "custom_domain": true },
    { "pattern": "www.fullcircle-co.com", "custom_domain": true }
  ],
  // twice a day, one call that keeps the free-plan Supabase project from pausing (src/worker.ts, `scheduled`)
  "triggers": { "crons": ["23 5 * * *", "47 17 * * *"] },
  // kept on (9 Nov 2026): preview builds need it, and the Worker sends its own workers.dev address to the
  // domain with a 301 (src/canonical.ts), so that copy is never indexed; previews are noindex by Cloudflare
  "workers_dev": true,
  "preview_urls": true,
  // `wrangler preview` (Cloudflare's preview builds) refuses to run without this block; it can stay
  // empty, as the settings above apply to previews too
  "previews": {}
}
