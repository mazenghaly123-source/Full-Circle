// Cloudflare Workers with static assets and no Astro adapter (see
// docs/adr/0002-cloudflare-workers-static-assets.md). Keep this file: without it, `wrangler deploy`
// sets up an adapter and a Worker on its own. The one Worker, src/worker.ts, serves the pages'
// markdown versions (docs/adr/0006-a-worker-for-markdown.md) and runs only on the paths in
// `run_worker_first`; everything else is served straight from the assets.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "full-circle",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // the pages with a markdown version (src/md/registry.ts; tests/unit/md.spec.ts keeps the two
    // lists the same), their .md files, and /api/md/
    "run_worker_first": [
      "/", "/how-it-works", "/what-we-make", "/about", "/request-a-sample", "/track", "/contact", "/privacy",
      "/*.md", "/api/md", "/api/md/*"
    ]
  },
  // the live site: each `wrangler deploy` from main attaches these as Custom Domains (Cloudflare adds
  // their DNS records and certificates)
  "routes": [
    { "pattern": "fullcircle-co.com", "custom_domain": true },
    { "pattern": "www.fullcircle-co.com", "custom_domain": true }
  ],
  // set to false once fullcircle-co.com is confirmed live, so the workers.dev copy is not indexed
  "workers_dev": true,
  "preview_urls": true,
  // `wrangler preview` (Cloudflare's preview builds) refuses to run without this block; it can stay
  // empty, as the settings above apply to previews too
  "previews": {}
}
