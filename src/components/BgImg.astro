---
// A full-bleed background photo (.bgimg) behind a hero or a card. A slot with a tall version in
// PHOTOS_PHONE shows that one up to `phoneUpTo` wide, so a phone does not crop a wide photo to a strip.
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { PHOTOS, PHOTOS_PHONE, photoWidths } from '../data/photos';

interface Props {
  /** Photo slot name, e.g. cat-denim (the prototype's data-img). */
  img: string;
  sizes: string;
  eager?: boolean;
  class?: string;
  /** The widest screen, in px, that gets the tall version (when the slot has one). */
  phoneUpTo?: number;
}

const { img: slot, sizes, eager = false, class: cls, phoneUpTo = 760 } = Astro.props;
const photo = PHOTOS[slot];
const phone = PHOTOS_PHONE[slot];
const srcset = async (src: ImageMetadata, format: 'avif' | 'webp' | 'jpg') =>
  (await getImage({ src, format, widths: photoWidths(src) })).srcSet.attribute;
const fallback = phone && photo ? await getImage({ src: photo, format: 'jpg', widths: photoWidths(photo) }) : undefined;
const sources = phone && photo ? [
  ...await Promise.all((['avif', 'webp', 'jpg'] as const).map(async (f) => ({ media: `(max-width: ${phoneUpTo}px)`, type: `image/${f === 'jpg' ? 'jpeg' : f}`, srcset: await srcset(phone, f), sizes: '100vw' }))),
  ...await Promise.all((['avif', 'webp'] as const).map(async (f) => ({ media: undefined, type: `image/${f}`, srcset: await srcset(photo, f), sizes }))),
] : [];
---
<div class:list={['bgimg', cls]} data-img={slot}>
  {photo && fallback ? (
    <picture>
      {sources.map((s) => <source media={s.media} srcset={s.srcset} type={s.type} sizes={s.sizes} />)}
      <img
        src={fallback.src}
        srcset={fallback.srcSet.attribute}
        sizes={sizes}
        alt=""
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
        width={photo.width}
        height={photo.height}
      />
    </picture>
  ) : photo && (
    <Picture
      src={photo}
      formats={['avif', 'webp']}
      widths={photoWidths(photo)}
      sizes={sizes}
      alt=""
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
    />
  )}
</div>
