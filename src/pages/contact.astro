---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { EMAIL, INSTAGRAM, INSTAGRAM_URL, PHONE, PHONE_URL, ROUTES, WHATSAPP, WHATSAPP_URL } from '../data/site';
---
<Base page="contact" title="Contact / Full Circle" description="WhatsApp is the fastest way to reach Full Circle in Cairo. Phone, email and Instagram are here too; for a production enquiry, request a sample.">
<PageHero crumb="Contact" title="Talk to us." lead="WhatsApp is the fastest way to reach us. For a production enquiry, the sample request gets you an answer quicker." light="radial-gradient(40% 50% at 85% 25%,#243E8F,transparent 70%)" />
<section class="wrap" style="padding-block:clamp(48px,6vw,88px) clamp(88px,10vw,150px)">
  <div class="cgrid">
    <div class="ccards">
      <div><span class="mono dim">WhatsApp</span><span><a class="cv" href={WHATSAPP_URL} target="_blank" rel="noopener"><b id="cWa">{WHATSAPP}</b></a><button class="copy" data-copy="cWa">Copy</button><a class="copy" href={WHATSAPP_URL} target="_blank" rel="noopener">Open chat ↗</a></span></div>
      <div><span class="mono dim">Phone</span><span><a class="cv" href={PHONE_URL}><b id="cTel">{PHONE}</b></a><button class="copy" data-copy="cTel">Copy</button></span></div>
      <div><span class="mono dim">Instagram</span><span><a class="cv" href={INSTAGRAM_URL} target="_blank" rel="noopener"><b>{INSTAGRAM}</b></a><a class="copy" href={INSTAGRAM_URL} target="_blank" rel="noopener">Open ↗</a></span></div>
      <div><span class="mono dim">Email</span><span><a class="cv" href={`mailto:${EMAIL}`}><b id="cMail">{EMAIL}</b></a><button class="copy" data-copy="cMail">Copy</button></span></div>
      <div><span class="mono dim">Where</span><b>Cairo, Egypt / visits by appointment</b></div>
      <div><span class="mono dim">Hours</span><b>Sunday – Thursday / 9:00 – 17:00 <span class="tbc">TBC</span></b></div>
      <div><span class="mono dim">Markets</span><b>Gulf + Middle East / Turkey / China</b></div>
      <div><span class="mono dim">Other</span><span style="color:var(--cotton)">Press, partnerships and careers: email us and put the topic in the subject line.</span></div>
    </div>
    <div>
      <form id="cForm" novalidate style="display:grid;gap:14px">
        <input class="field" id="cName" placeholder="Your name" autocomplete="name" aria-label="Your name">
        <input class="field" id="cReach" placeholder="Email or WhatsApp" autocomplete="email" aria-label="Email or WhatsApp">
        <textarea class="field" id="cMsg" placeholder="Message" aria-label="Message"></textarea>
        <div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap"><button class="btn btn-red" type="submit">Send message</button><a href={ROUTES.start} class="mono dim">Production enquiry? Request a sample</a></div>
        <span class="mono" id="cErr" style="color:var(--red);min-height:1em" role="alert"></span>
      </form>
      <div id="cDone" hidden style="display:grid;gap:10px"><h3 class="camp" style="font-size:56px">Sent.</h3><p style="margin:0;color:var(--cotton)">We will reply on the contact you gave.</p></div>
    </div>
  </div>
</section>
</Base>
