---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import BgImg from '../components/BgImg.astro';
import CtaBand from '../components/CtaBand.astro';
import { FAQ, INSTAGRAM, INSTAGRAM_URL, MAKE, PHONE, PHONE_URL, ROUTES, STAGES, WHATSAPP, WHATSAPP_URL, pad, ring } from '../data/site';

// hero ring: stage labels just outside the ring, between the ticks
const heroLabels = STAGES.map((g, i) => {
  const [x, y] = ring(200, 200, 186, i / 8 + 1 / 16);
  return { x, y, cls: 'st' + (x > 300 ? ' sr' : x < 100 ? ' sl' : '') + (i < 1 ? ' on' : ''), t: g.s };
});
// the ring is drawn at its first stage, where the prototype's script put it before the first paint
const [heroDotX, heroDotY] = ring(200, 200, 150, 1 / 8);
// how it works ring: one tick per stage
const howTicks = STAGES.map((_, i) => {
  const [x1, y1] = ring(200, 200, 160, i / 8), [x2, y2] = ring(200, 200, 180, i / 8);
  return { x1, y1, x2, y2 };
});
const ATELIER = [
  { slot: 'atelier-1', tone: 'radial-gradient(70% 60% at 30% 30%,#6b5644,#2a2622 72%)', cap: 'Worktable / Cairo' },
  { slot: 'atelier-2', tone: 'radial-gradient(70% 60% at 50% 40%,#8a7f6c,#3a352e 72%)', cap: 'Sketch' },
  { slot: 'atelier-3', tone: 'radial-gradient(70% 60% at 50% 50%,#7a6450,#30291f 72%)', cap: 'Pattern' },
  { slot: 'atelier-4', tone: 'radial-gradient(70% 60% at 40% 40%,#3d3d38,#1b1b18 72%)', cap: 'Fabric' },
  { slot: 'atelier-5', tone: 'radial-gradient(70% 60% at 50% 40%,#3b4f7a,#1d2638 72%)', cap: 'Garment' },
];
---
<Base page="home" title="Full Circle / Idea to product" description="Design, patterns, fabric, samples and bulk production under one roof in Cairo, for clothing brands that are starting or scaling. What you approve in sampling is what ships.">
<section class="hero grain"><BgImg img="hero" sizes="100vw" eager />
  <div class="light"></div>
  <div class="wrap">
    <div>
      <div class="mono dim" style="margin-bottom:22px">Development + manufacturing / Cairo, Egypt</div>
      <h1 class="camp">Idea to product. Full circle.</h1>
      <p class="lead">Design, patterns, fabric, samples and bulk production under one roof, for clothing brands that are starting or scaling. What you approve in sampling is what ships.</p>
      <div class="cta"><a href={ROUTES.start} class="btn btn-red">Request a sample</a><a href={ROUTES.how} class="btn btn-line">How it works</a></div>
      <p class="mono dim note">Free first call / reply within one working day <span class="tbc">TBC</span></p>
    </div>
    <div class="ringwrap">
      <svg viewBox="0 0 400 400">
        <g transform="rotate(-90 200 200)"><circle class="bg" cx="200" cy="200" r="150"/><circle class="fg" id="heroArc" cx="200" cy="200" r="150" pathLength="100" stroke-dashoffset="100" style="stroke-dashoffset:87.5"/></g>
        <g id="heroLabels">{heroLabels.map((l) => <text x={l.x} y={l.y} text-anchor="middle" class={l.cls}>{l.t}</text>)}</g>
        <circle class="reddot" id="heroDot" r="7" cx={heroDotX} cy={heroDotY}/>
      </svg>
      <svg class="heromark" viewBox="0 0 256.86 262.30" aria-hidden="true"><use href="#fc-mark"/></svg>
      <canvas class="mark3" id="mark3" aria-hidden="true"></canvas>
    </div>
    <script is:inline>
      // before the first paint, as in the prototype: hold the flat mark back while the 3D one loads,
      // and with reduced motion show the ring complete
      (function () {
        var w = document.currentScript.previousElementSibling;
        if (!w || !w.classList.contains('ringwrap')) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
          w.querySelector('#heroArc').style.strokeDashoffset = '14';
          w.querySelectorAll('#heroLabels text').forEach(function (t) { t.classList.add('on'); });
        }
        try { var c = document.createElement('canvas'); if (c.getContext('webgl2') || c.getContext('webgl')) w.classList.add('m3wait'); } catch (e) {}
      })();
    </script>
  </div>
  <div class="wrap">
    <div class="facts">
      <div><b>From <span data-count="60">60</span> pcs</b><span class="mono dim">Minimum per colour</span></div>
      <div><b>7–25 days</b><span class="mono dim">To a first sample</span></div>
      <div><b>Denim first</b><span class="mono dim">Imported fabrics + trims</span></div>
      <div><b>Live tracking</b><span class="mono dim">Code, stage, next decision</span></div>
    </div>
  </div>
</section>

<section class="wrap sec" id="who">
  <div class="sh"><h2 class="camp">Where is your brand?</h2><p>Two ways in. Pick the one that sounds like you and we start from there.</p></div>
  <div class="who snap" id="whoRow">
    <article class="who-card"><BgImg img="path-starting" sizes="(max-width: 760px) 84vw, (max-width: 820px) 100vw, 50vw" />
      <div class="glow" style="background:radial-gradient(40% 40% at 20% 20%,#C96832,transparent 70%)"></div>
      <div class="mono dim">A / Starting a brand</div>
      <div style="display:grid;gap:18px;align-content:start"><h3 class="camp">Starting.</h3><p>You have an idea, maybe a sketch, and no factory yet. We turn it into a product you can sell.</p>
        <ul><li>Research and design support</li><li>Tech pack from your sketch</li><li>Fabric sourcing and first samples</li></ul></div>
      <div style="display:flex;gap:10px;flex-wrap:wrap"><a class="btn btn-red" href={`${ROUTES.start}?path=Starting`}>Start a new brand</a><span class="mono dim" style="align-self:center">Enter at stage 01</span></div>
    </article>
    <article class="who-card"><BgImg img="path-scaling" sizes="(max-width: 760px) 84vw, (max-width: 820px) 100vw, 50vw" />
      <div class="glow" style="background:radial-gradient(40% 40% at 80% 20%,#243E8F,transparent 70%)"></div>
      <div class="mono dim">B / Scaling a brand</div>
      <div style="display:grid;gap:18px;align-content:start"><h3 class="camp">Scaling.</h3><p>You already sell, and your last run did not match the sample. We lock the product and repeat it.</p>
        <ul><li>Pattern review from your garment</li><li>Bulk-ready samples</li><li>QC on every run, repeat orders</li></ul></div>
      <div style="display:flex;gap:10px;flex-wrap:wrap"><a class="btn btn-red" href={`${ROUTES.start}?path=Scaling`}>Move production to us</a><span class="mono dim" style="align-self:center">Enter at stage 04</span></div>
    </article>
  </div>
  <div class="dots" data-for="whoRow"></div>
</section>

<section class="wrap" id="h-make" style="padding-bottom:clamp(88px,10vw,150px)">
  <div class="sh"><h2 class="camp">What we make</h2><p>Denim is our speciality. We import fabrics and trims you will not find in the local market, and start from 60 pieces per colour.</p></div>
  <div class="make snap" id="makeGrid">{MAKE.map((m, i) => (
    <a class="cat" href={`${ROUTES.make}#cat-${m.id}`}><Photo img={`cat-${m.id}`} tone={m.tone} caption={[pad(i + 1), 'Photo']} sizes="(max-width: 620px) 56vw, (max-width: 1000px) 33vw, 17vw" /><h3 class="camp">{m.n}</h3><span class="mono">{m.sub}</span></a>
  ))}</div><div class="dots" data-for="makeGrid"></div>
  <div class="make-foot"><span class="mono dim">Minimums per category / fabric lists coming</span><a href={ROUTES.make} class="btn btn-line">All capabilities</a></div>
</section>

<section class="wrap sec" id="h-how" style="border-top:1px solid var(--faint)">
  <div class="sh"><h2 class="camp">How it works</h2><p>Eight stages. Each one ends with something you can see and a decision you make. The next stage starts only when that decision is clear.</p></div>
  <div class="howscroll" id="howScroll"><div class="howpin" id="howPin">
  <div class="how">
    <div class="howring" aria-hidden="true">
      <svg viewBox="0 0 400 400">
        <g transform="rotate(-90 200 200)"><circle class="bg" cx="200" cy="200" r="170"/><circle class="fg" id="howArc" cx="200" cy="200" r="170" pathLength="100" stroke-dashoffset="100"/></g>
        <g id="howTicks">{howTicks.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class="tk"/>)}</g>
        <circle class="ping" id="howPing" r="8" cx="200" cy="30"/>
        <circle class="dot" id="howDot" r="8" cx="200" cy="30"/>
        <text class="big" id="howNum" x="200" y="232" text-anchor="middle">01</text>
        <use class="mk" href="#fc-mark" x="150" y="132" width="100" height="102"/>
        <text class="lbl" id="howLbl" x="200" y="262" text-anchor="middle">Research</text>
      </svg>
    </div>
    <div><ol class="steps" id="steps">{STAGES.map((g, i) => (
      <li class="step"><button aria-expanded="false"><span class="n">{pad(i + 1)}</span><span class="t">{g.n}</span><span class="a">{g.ok}</span></button><div class="body"><div><p>{g.line}</p><dl><dt>You receive</dt><dd style="margin:0">{g.get}</dd><dt>You approve</dt><dd style="margin:0">{g.ok}</dd></dl></div></div></li>
    ))}</ol><div class="howfoot"><span class="mono dim hownext" id="howNext"></span><a href={ROUTES.how} class="linkline">The full process</a></div></div>
  </div>
  </div></div>
</section>

<section class="promise grain">
  <div class="light"></div>
  <div class="wrap sec">
    <div>
      <div class="mono dim" style="margin-bottom:18px">The promise</div>
      <h2 class="camp">What you approve is what ships.</h2>
      <p>The sample you sign becomes the reference. Every bulk piece is measured against it: chest, length, sleeve, stitch, colour. If it does not match, it does not leave.</p>
    </div>
    <div class="vs">
      <Photo img="promise-sample" tone="radial-gradient(70% 60% at 40% 40%,#3b4f7a,#1d2638 72%)" caption={['Sample 03', 'Signed']} sizes="(max-width: 760px) 135px, 240px" />
      <span class="eq">=</span>
      <Photo img="promise-bulk" tone="radial-gradient(70% 60% at 60% 40%,#3b4f7a,#1d2638 72%)" caption={['Bulk 0412', 'QC pass']} sizes="(max-width: 760px) 135px, 240px" />
    </div>
  </div>
</section>

<section class="bone" id="h-track">
  <div class="wrap sec">
    <div class="sh"><h2 class="camp">Nothing ships unseen.</h2></div>
    <div class="track">
      <div>
        <p>Every order gets a code and a page. You see the stage it is in, what you have approved, and the next decision we need from you.</p>
        <ul><li>Approve samples and fabric from your phone</li><li>Request a photo of any stage</li><li>A record of every decision, kept with the order</li></ul>
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:28px"><a href={ROUTES.track} class="btn btn-line">Track your order</a><span class="mono" style="align-self:center;opacity:0.6">Live demo on the right</span></div>
      </div>
      <div class="portal">
        <div class="prow"><span class="mono" style="font-size:13px">FC-2418 / Overshirt</span><span class="chipst mono" id="pChip"><i></i><span id="pChipT">Awaiting approval</span></span></div>
        <div class="pbody">
          <Photo img="portal-sample" caption={['Sample 03', 'Photo']} sizes="(max-width: 760px) 110px, (max-width: 860px) 40vw, 260px" />
          <div class="kv">
            <div><span>Stage</span><span id="pStage">05 / Sampling</span></div>
            <div><span>Item</span><span>Sample 03 / Fit + fabric</span></div>
            <div><span>Next decision</span><span id="pNext">Approve sample 03</span></div>
            <div class="stamp" id="pStamp">✓ Approved</div>
          </div>
        </div>
        <div class="rail" id="pRail">{STAGES.map((g) => <div><i></i><span>{g.s}</span></div>)}</div>
        <div class="prow" style="border-bottom:0;border-top:1px solid var(--line-d)">
          <button class="btn btn-line" id="pPhoto">Request a photo</button>
          <button class="btn btn-red" id="pApprove">Approve sample</button>
        </div>
        <div class="plog" id="pLog" hidden></div>
      </div>
    </div>
  </div>
</section>

<section class="wrap sec" id="proof">
  <div class="sh"><h2 class="camp">The atelier</h2><p>Real photos from the floor go here. Client work and logos are added after the first pilot run.</p></div>
  <div class="proof snap" id="proofRow">
    {ATELIER.map((a) => <Photo img={a.slot} tone={a.tone} caption={[a.cap, 'Photo']} sizes="(max-width: 760px) 68vw, 50vw" />)}
  </div>
  <div class="dots" data-for="proofRow"></div>
  <div class="logos" aria-label="Client logos, coming after pilot run"><div class="mono">Logo</div><div class="mono">Logo</div><div class="mono">Logo</div><div class="mono">Logo</div><div class="mono">Logo</div><div class="mono">Logo</div></div>
</section>

<CtaBand title="Request a sample." text="Four quick picks, under a minute. We reply with a first call, a price range and the next decision."><a href={ROUTES.start} class="btn btn-red" style="padding:16px 22px">Start the request</a></CtaBand>

<section class="wrap sec" id="faq">
  <div class="sh"><h2 class="camp">Questions</h2></div>
  <div class="faq" id="faqList">{FAQ.map(([q, a], i) => <details><summary><span class="mono dim">{pad(i + 1)}</span><h3>{q}</h3><span class="plus"></span></summary><p class="ans">{a}</p></details>)}</div>
</section>

<section class="wrap" id="h-contact" style="padding-bottom:clamp(64px,7vw,100px)">
  <div class="contact">
    <div><span class="mono dim">WhatsApp</span><a class="cv" href={WHATSAPP_URL} target="_blank" rel="noopener"><b>{WHATSAPP}</b><span class="ar">↗</span></a></div>
    <div><span class="mono dim">Phone</span><a class="cv" href={PHONE_URL}><b>{PHONE}</b></a></div>
    <div><span class="mono dim">Instagram</span><a class="cv" href={INSTAGRAM_URL} target="_blank" rel="noopener"><b>{INSTAGRAM}</b><span class="ar">↗</span></a></div>
    <div><span class="mono dim">Studio + floor</span><b>Cairo, Egypt</b></div>
  </div>
</section>
</Base>
