---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import BgImg from '../components/BgImg.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { STAGE_ICONS } from '../data/icons';
import { FAQ, INSTAGRAM, INSTAGRAM_URL, MAKE, PHONE, PHONE_URL, ROUTES, STAGES, WHATSAPP, WHATSAPP_URL, pad, ring, sampleLine } from '../data/site';

// hero ring: stage labels just outside the ring, between the ticks
const heroLabels = STAGES.map((g, i) => {
  const [x, y] = ring(200, 200, 186, i / 8 + 1 / 16);
  return { x, y, cls: 'st' + (x > 300 ? ' sr' : x < 100 ? ' sl' : '') + (i < 1 ? ' on' : ''), t: g.s };
});
// the ring is drawn at its first stage, where the prototype's script put it before the first paint
const [heroDotX, heroDotY] = ring(200, 200, 150, 1 / 8);
// how it works ring: one tick per stage
const howTicks = STAGES.map((_, i) => {
  const [x1, y1] = ring(200, 200, 160, i / 8), [x2, y2] = ring(200, 200, 180, i / 8);
  return { x1, y1, x2, y2 };
});
// the atelier waits for real photos of the floor (Mazen, 23 Oct 2026): placeholders read as a to-do
const SHOW_ATELIER = false;
const ATELIER = [
  { slot: 'atelier-1', tone: 'radial-gradient(70% 60% at 30% 30%,#6b5644,#2a2622 72%)', cap: 'Worktable / Cairo' },
  { slot: 'atelier-2', tone: 'radial-gradient(70% 60% at 50% 40%,#8a7f6c,#3a352e 72%)', cap: 'Sketch' },
  { slot: 'atelier-3', tone: 'radial-gradient(70% 60% at 50% 50%,#7a6450,#30291f 72%)', cap: 'Pattern' },
  { slot: 'atelier-4', tone: 'radial-gradient(70% 60% at 40% 40%,#3d3d38,#1b1b18 72%)', cap: 'Fabric' },
  { slot: 'atelier-5', tone: 'radial-gradient(70% 60% at 50% 40%,#3b4f7a,#1d2638 72%)', cap: 'Garment' },
];
---
<Base page="home" title="Full Circle / Clothing manufacturer in Cairo, Egypt" description="Design, patterns, fabric, samples and bulk production under one roof in Cairo, for clothing brands starting or scaling. From 60 pieces per colour.">
<section class="hero grain"><BgImg img="hero" sizes="100vw" eager />
  <div class="light"></div>
  <div class="scrim" aria-hidden="true"></div>
  <div class="wrap">
    <div>
      <h1 class="camp wide"><span class="l1">Idea to product.</span> <span class="l2">Full circle.</span></h1>
      <p class="lead">From idea to bulk, under one roof in Cairo. What you approve in sampling is what ships.</p>
      <div class="cta"><a href={ROUTES.start} class="btn btn-red">Request a sample</a><a href={ROUTES.how} class="btn btn-line">How it works</a></div>
      <p class="mono dim note">Free first call / we reply quickly</p>
    </div>
    <div class="ringwrap">
      <svg viewBox="0 0 400 400" aria-hidden="true">
        <g transform="rotate(-90 200 200)"><circle class="bg" cx="200" cy="200" r="150"/><circle class="fg" id="heroArc" cx="200" cy="200" r="150" pathLength="100" stroke-dashoffset="100" style="stroke-dashoffset:87.5"/></g>
        <g id="heroLabels">{heroLabels.map((l) => <text x={l.x} y={l.y} text-anchor="middle" class={l.cls}>{l.t}</text>)}</g>
        <circle class="reddot" id="heroDot" r="7" cx={heroDotX} cy={heroDotY}/>
      </svg>
      <svg class="heromark" viewBox="0 0 256.86 262.30" aria-hidden="true"><use href="#fc-mark"/></svg>
      <canvas class="mark3" id="mark3" aria-hidden="true"></canvas>
    </div>
    <script is:inline>
      // before the first paint, as in the prototype: hold the flat mark back while the 3D one loads,
      // and with reduced motion show the ring complete
      (function () {
        if (document.readyState !== 'loading') return; // after a page swap the scripts handle it
        var w = document.currentScript.previousElementSibling;
        if (!w || !w.classList.contains('ringwrap')) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
          w.querySelector('#heroArc').style.strokeDashoffset = '14';
          w.querySelectorAll('#heroLabels text').forEach(function (t) { t.classList.add('on'); });
          var d = w.querySelector('#heroDot'); d.setAttribute('cx', '200'); d.setAttribute('cy', '50');
        }
        try { var c = document.createElement('canvas'); if (c.getContext('webgl2') || c.getContext('webgl')) w.classList.add('m3wait'); } catch (e) {}
      })();
    </script>
  </div>
  <div class="wrap">
    <div class="facts">
      <div class="fi"><Icon name="pieces" /><b>From <span data-count="60">60</span> pcs</b></div>
      <div class="fi"><Icon name="clock" /><b>7–25 day samples</b></div>
      <div class="fi"><Icon name="denim" /><b>Denim + imports</b></div>
      <div class="fi"><Icon name="ring" /><b>Live tracking</b></div>
    </div>
  </div>
</section>

<section class="wrap sec" id="who">
  <div class="sh"><h2 class="camp wide">Where is your brand?</h2></div>
  <div class="who snap" id="whoRow">
    <article class="who-card"><BgImg img="path-starting" sizes="(max-width: 760px) 84vw, (max-width: 820px) 100vw, 50vw" />
      <div class="glow" style="background:radial-gradient(40% 40% at 20% 20%,#C96832,transparent 70%)"></div>
      <div class="who-t"><h3 class="camp">Starting.</h3><p>An idea, no factory yet.</p></div>
      <div class="icrow"><span><Icon name="design" />Design</span><span><Icon name="techpack" />Tech pack</span><span><Icon name="sample" />First samples</span></div>
      <div><a class="btn btn-red" href={`${ROUTES.start}?path=Starting`}>Start a new brand</a></div>
    </article>
    <article class="who-card"><BgImg img="path-scaling" sizes="(max-width: 760px) 84vw, (max-width: 820px) 100vw, 50vw" />
      <div class="glow" style="background:radial-gradient(40% 40% at 80% 20%,#243E8F,transparent 70%)"></div>
      <div class="who-t"><h3 class="camp">Scaling.</h3><p>Selling already. Bulk must match.</p></div>
      <div class="icrow"><span><Icon name="pattern" />Pattern review</span><span><Icon name="bulk" />Bulk samples</span><span><Icon name="qc" />QC every run</span></div>
      <div><a class="btn btn-red" href={`${ROUTES.start}?path=Scaling`}>Move production to us</a></div>
    </article>
  </div>
  <div class="dots" data-for="whoRow"></div>
</section>

<section class="wrap" id="h-make" style="padding-bottom:clamp(88px,10vw,150px)">
  <div class="sh"><h2 class="camp wide">What we make</h2><p>Denim first. Imported fabrics and trims.</p></div>
  <div class="make snap acc" id="makeGrid">{MAKE.map((m, i) => (
    <a class={i === 0 ? 'cat on' : 'cat'} href={`${ROUTES.make}#cat-${m.id}`}><Photo img={`cat-${m.id}`} tone={m.tone} sizes="(max-width: 760px) 72vw, 45vw" /><span class="num mono">{i === 0 ? 'Our specialty' : pad(i + 1)}</span><span class="v" aria-hidden="true">{m.n}</span><div class="t"><h3 class="camp">{m.n}</h3><div class="meta"><span><Icon name="pieces" />{m.sub}</span><span><Icon name="clock" />{sampleLine(m.samp)}</span></div><span class="go mono">See details</span></div></a>
  ))}</div><div class="dots" data-for="makeGrid"></div>
  <div class="make-foot"><a href={ROUTES.make} class="btn btn-line">All capabilities</a></div>
</section>

<section class="wrap sec" id="h-how" style="border-top:1px solid var(--faint)">
  <div class="sh"><h2 class="camp wide">How it works</h2><p>Eight stages. You approve each one.</p></div>
  <div class="howscroll" id="howScroll"><div class="howpin" id="howPin">
  <div class="hbgs" aria-hidden="true">{STAGES.map((g, i) => <BgImg img={`stage-${pad(i + 1)}`} sizes="100vw" class={i === 0 ? 'on' : undefined} />)}</div>
  <div class="how">
    <div class="howring" aria-hidden="true">
      <svg viewBox="0 0 400 400">
        <g transform="rotate(-90 200 200)"><circle class="bg" cx="200" cy="200" r="170"/><circle class="fg" id="howArc" cx="200" cy="200" r="170" pathLength="100" stroke-dashoffset="100"/></g>
        <g id="howTicks">{howTicks.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class="tk"/>)}</g>
        <circle class="ping" id="howPing" r="8" cx="200" cy="30"/>
        <circle class="dot" id="howDot" r="8" cx="200" cy="30"/>
        <text class="big" id="howNum" x="200" y="232" text-anchor="middle">01</text>
        <use class="mk" href="#fc-mark" x="150" y="132" width="100" height="102"/>
        <text class="lbl" id="howLbl" x="200" y="262" text-anchor="middle">Research</text>
      </svg>
    </div>
    <div><ol class="steps" id="steps">{STAGES.map((g, i) => (
      <li class="step"><button aria-expanded="false"><span class="n">{pad(i + 1)}</span><span class="t">{g.n}</span><span class="a"><Icon name={STAGE_ICONS[i]} /></span></button><div class="body"><div><p class="ok1"><Icon name="qc" /><span>{g.ok}</span></p></div></div></li>
    ))}</ol><div class="howfoot"><span class="mono dim hownext" id="howNext"></span><a href={ROUTES.how} class="linkline">The full process</a></div></div>
  </div>
  </div></div>
</section>

<section class="promise grain">
  <div class="light"></div>
  <div class="wrap sec">
    <div>
      <h2 class="camp wide">What you approve is what ships.</h2>
      <p>Every bulk piece is checked against your signed sample.</p>
      <ul class="checks" aria-label="Checked against the sample">{(['chest', 'length', 'sleeve', 'stitch', 'colour'] as const).map((k) => <li><Icon name={k} />{k}</li>)}</ul>
    </div>
    <div class="vs">
      <Photo img="promise-sample" describe tone="radial-gradient(70% 60% at 40% 40%,#3b4f7a,#1d2638 72%)" caption={['Sample 03', 'Signed']} sizes="(max-width: 760px) 135px, 240px" />
      <span class="eq">=</span>
      <Photo img="promise-bulk" describe tone="radial-gradient(70% 60% at 60% 40%,#3b4f7a,#1d2638 72%)" caption={['Bulk 0412', 'QC pass']} sizes="(max-width: 760px) 135px, 240px" />
    </div>
  </div>
</section>

<section class="bone" id="h-track">
  <div class="wrap sec">
    <div class="sh"><h2 class="camp wide">Nothing ships unseen.</h2></div>
    <div class="track">
      <div>
        <p>Every order gets a code and a page.</p>
        <ul class="iclist"><li><Icon name="phone" />Approve from your phone</li><li><Icon name="camera" />Ask for a photo of any stage</li><li><Icon name="log" />Every decision on record</li></ul>
        <div style="margin-top:28px"><a href={ROUTES.track} class="btn btn-line">Track your order</a></div>
      </div>
      <div class="portal">
        <div class="prow"><span class="mono" style="font-size:13px">FC-2418 / Denim jeans</span><span class="chipst mono" id="pChip"><i></i><span id="pChipT">Awaiting approval</span></span></div>
        <div class="pbody">
          <Photo img="portal-sample" describe caption={['Sample 03', 'Photo']} sizes="(max-width: 760px) 110px, (max-width: 860px) 40vw, 260px" />
          <div class="kv">
            <div><span>Stage</span><span id="pStage">05 / Sampling</span></div>
            <div><span>Item</span><span>Sample 03 / Fit + fabric</span></div>
            <div><span>Next decision</span><span id="pNext">Approve sample 03</span></div>
            <div class="stamp" id="pStamp">✓ Approved</div>
          </div>
        </div>
        <div class="rail" id="pRail">{STAGES.map((g) => <div><i></i><span>{g.s}</span></div>)}</div>
        <div class="prow" style="border-bottom:0;border-top:1px solid var(--line-d)">
          <button class="btn btn-line" id="pPhoto">Request a photo</button>
          <button class="btn btn-red" id="pApprove">Approve sample</button>
        </div>
        <div class="plog" id="pLog" hidden></div>
      </div>
    </div>
  </div>
</section>

{SHOW_ATELIER && (
<section class="wrap sec" id="proof">
  <div class="sh"><h2 class="camp">The atelier</h2><p>Real photos from the floor go here. Client work and logos are added after the first pilot run.</p></div>
  <div class="proof snap" id="proofRow" tabindex="0" role="region" aria-label="Atelier photos">
    {ATELIER.map((a) => <Photo img={a.slot} tone={a.tone} caption={[a.cap, 'Photo']} sizes="(max-width: 760px) 68vw, 50vw" />)}
  </div>
  <div class="dots" data-for="proofRow"></div>
  <div class="logos" role="img" aria-label="Client logos, coming after pilot run"><div class="mono">Logo</div><div class="mono">Logo</div><div class="mono">Logo</div><div class="mono">Logo</div><div class="mono">Logo</div><div class="mono">Logo</div></div>
</section>
)}

<CtaBand title="Request a sample." text="Four picks, under a minute. No account needed."><a href={ROUTES.start} class="btn btn-red" style="padding:16px 22px">Start the request</a></CtaBand>

<section class="wrap sec" id="faq">
  <div class="sh"><h2 class="camp wide">Questions</h2></div>
  <div class="faq" id="faqList">{FAQ.map(([q, a], i) => <details><summary><span class="mono dim">{pad(i + 1)}</span><h3>{q}</h3><span class="plus"></span></summary><p class="ans">{a}</p></details>)}</div>
</section>

<section class="wrap" id="h-contact" style="padding-bottom:clamp(64px,7vw,100px)">
  <div class="contact">
    <div><span class="mono dim">WhatsApp</span><a class="cv" href={WHATSAPP_URL} target="_blank" rel="noopener"><b>{WHATSAPP}</b><span class="ar" aria-hidden="true">↗</span></a></div>
    <div><span class="mono dim">Phone</span><a class="cv" href={PHONE_URL}><b>{PHONE}</b></a></div>
    <div><span class="mono dim">Instagram</span><a class="cv" href={INSTAGRAM_URL} target="_blank" rel="noopener"><b>{INSTAGRAM}</b><span class="ar" aria-hidden="true">↗</span></a></div>
    <div><span class="mono dim">Studio + floor</span><b>Cairo, Egypt</b></div>
  </div>
</section>
</Base>
