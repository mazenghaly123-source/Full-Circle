---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import BgImg from '../components/BgImg.astro';
import Icon from '../components/Icon.astro';
import { ROUTES } from '../data/site';

---
<Base page="about" title="About / Clothing development partner in Cairo / Full Circle" description="A development and manufacturing partner for clothing brands, based in Cairo. One team holds the whole chain, from first sketch to delivered bulk.">
<PageHero crumb="About" title="Fashion culture leads. Process proves it." lead="One partner in Cairo, from the first sketch to delivered bulk." light="radial-gradient(40% 50% at 85% 20%,#C96832,transparent 70%),radial-gradient(40% 50% at 20% 90%,#A63F3F,transparent 72%)" wide><BgImg img="about-floor" sizes="100vw" eager slot="bg" /></PageHero>
<section class="wrap sec">
  <div class="sh"><h2 class="camp wide">Why one partner</h2></div>
  <div class="chain">
    <div><span class="mono dim">The usual way</span>
      <div class="links"><span>Designer</span><i>/ gap /</i><span>Pattern maker</span><i>/ gap /</i><span>Fabric supplier</span><i>/ gap /</i><span>Factory</span></div>
      <p style="margin:0;color:var(--cotton)">Four suppliers, and a bulk run that does not match the sample.</p></div>
    <div><span class="mono dim">With Full Circle</span>
      <div class="onering"><svg viewBox="0 0 256.86 262.30" aria-hidden="true" style="color:var(--bone)"><use href="#fc-mark"/></svg><p style="margin:0">One team. The sample you approve is what ships.</p></div></div>
  </div>
</section>
<section class="wrap" style="padding-bottom:clamp(88px,10vw,150px)">
  <div class="sh"><h2 class="camp wide">How we work with you</h2></div>
  <div class="three"><div><Icon name="techpack" /><b>Every stage has an output</b><span>You see it before we move on.</span></div><div><Icon name="qc" /><b>Every decision is yours</b><span>Nothing moves without your approval.</span></div><div><Icon name="camera" /><b>Nothing ships unseen</b><span>Ask for a photo of any stage.</span></div></div>
  <p class="mono dim" style="margin-top:56px">Coming next / Full Circle Studio, a consultancy arm for brands that need direction before production.</p>
</section>
<section class="wrap" style="padding-bottom:clamp(88px,10vw,150px)">
  <div class="sh"><h2 class="camp wide">Where we sell</h2></div>
  <div class="contact" style="border-top:0;margin-top:-12px">
    <div><Icon name="pin" /><b>Made in Cairo</b></div>
    <div><Icon name="globe" /><b>Gulf + Middle East</b></div>
    <div><Icon name="globe" /><b>Turkey</b></div>
    <div><Icon name="globe" /><b>China</b></div>
  </div>
</section>
<CtaBand title="Come and see." text="A first call, or a visit to the floor in Cairo."><a href={ROUTES.start} class="btn btn-red" style="padding:16px 22px">Request a sample</a></CtaBand>
</Base>
