---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { MAKE, ROUTES, pad, sampleLine } from '../data/site';
---
<Base page="make" title="Denim, tees, hoodies and more, made in Cairo / Full Circle" description="Denim, tees, hoodies, shirts, jackets and knitwear, developed and made in Cairo. Minimums from 60 pieces per colour; samples in 7 to 25 days.">
<PageHero crumb="What we make" title="What we make." lead="Six categories, made in Cairo. Denim first." light="radial-gradient(40% 50% at 80% 30%,#243E8F,transparent 70%),radial-gradient(40% 50% at 10% 90%,#C96832,transparent 72%)" wide>
    <div class="catnav" id="catNav">{MAKE.map((m, i) => <button class="opt" data-cat={m.id}><b>{pad(i + 1)}</b>{m.n}</button>)}</div>
</PageHero>
<section class="wrap mcats" id="catPanels">{MAKE.map((m, i) => (
  <article class="mcat" id={`cat-${m.id}`}><Photo img={`cat-${m.id}`} tone={m.tone} caption={[i === 0 ? 'Our specialty' : pad(i + 1), 'Photo']} sizes="(max-width: 860px) 96vw, (max-width: 1440px) 48vw, 690px" eager={i === 0} describe /><div class="body"><h2 class="camp">{m.n}</h2><div class="mfacts"><span><Icon name="pieces" />{m.sub}</span><span><Icon name="clock" />{sampleLine(m.samp)}</span></div><p class="items">{m.items}</p><div class="mfoot"><a class="btn btn-red" href={`${ROUTES.start}?product=${encodeURIComponent(m.product)}`}>Request a sample</a></div></div></article>
))}</section>
<section class="wrap why">
  <div class="sh"><h2 class="camp wide">What sets us apart</h2></div>
  <div class="three"><div><Icon name="denim" /><b>Denim speciality</b><span>Pattern to wash, from 150 pcs / colour.</span></div><div><Icon name="source" /><b>Imported fabrics</b><span>Denims and fabrics not sold in Cairo.</span></div><div><Icon name="trims" /><b>Imported trims</b><span>Buttons, rivets, zips and labels from abroad.</span></div></div>
</section>
<CtaBand title="Not on the list?" text="Tell us. If it is not for us, we say so."><a href={ROUTES.start} class="btn btn-red" style="padding:16px 22px">Request a sample</a></CtaBand>
</Base>
