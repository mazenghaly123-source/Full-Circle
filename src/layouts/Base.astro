---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import Sprite from '../components/Sprite.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { EMAIL, INSTAGRAM_URL, PAGES, PHONE, SITE, WHATSAPP, WHATSAPP_URL, type PageKey } from '../data/site';
import { mdFile } from '../md/registry';
import '../styles/global.css';

interface Props {
  page: PageKey;
}

const { page } = Astro.props;
const { title, description, summary = description } = PAGES[page];
// the page's address on the domain, as the site links to it (/about, not /about.html)
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site).href;
const image = new URL('/og.jpg', Astro.site).href;
// the same page in markdown, for AI agents (src/md/registry.ts); every page but the 404 has one
const markdown = page !== 'notfound' && new URL(`/${mdFile(new URL(canonical).pathname)}.md`, Astro.site).href;
const tel = (n: string) => n.replace(/\s/g, '');
// who Full Circle is, and the site, for search engines: on Home only, where the business is the
// page's subject; the same words as llms.txt and ai.txt (SITE)
const home = new URL('/', Astro.site).href;
const business = page === 'home' && {
  '@context': 'https://schema.org',
  '@graph': [{
    '@type': 'Organization', '@id': `${home}#organization`, name: SITE.name, url: home,
    logo: new URL('/favicon.svg', Astro.site).href, image, description: SITE.summary, email: EMAIL, telephone: tel(PHONE),
    address: { '@type': 'PostalAddress', streetAddress: SITE.address.street, addressLocality: SITE.address.city, addressCountry: SITE.address.country },
    contactPoint: [{ '@type': 'ContactPoint', contactType: 'sales', telephone: tel(WHATSAPP), email: EMAIL }],
    sameAs: [INSTAGRAM_URL],
  }, {
    '@type': 'WebSite', '@id': `${home}#website`, name: SITE.name, url: home, inLanguage: 'en',
    publisher: { '@id': `${home}#organization` },
  }],
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="ai-summary" content={summary}>
{page === 'notfound' ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonical}>}
<meta property="og:type" content="website">
<meta property="og:site_name" content="Full Circle">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
{page !== 'notfound' && <meta property="og:url" content={canonical}>}
<meta property="og:image" content={image}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Full Circle: Idea to product. Full circle. Development and manufacturing in Cairo, Egypt.">
<meta name="twitter:card" content="summary_large_image">
{markdown && <link rel="alternate" type="text/markdown" href={markdown}>}
{business && <script type="application/ld+json" set:html={JSON.stringify(business)} />}
<meta name="theme-color" content="#11110F">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<style is:inline>[hidden]{display:none!important}body{margin:0}</style>
{/* preload only the hero's heading and body text; the rest load as the page styles them (the local
    font provider records no subsets, so each preloaded weight brings its latin-ext file too) */}
<Font cssVariable="--font-saira-condensed" preload={[{ weight: '700' }]} />
<Font cssVariable="--font-geist" preload={[{ weight: '400' }]} />
<Font cssVariable="--font-plex-mono" />
<Font cssVariable="--font-microgramma" preload={[{ weight: '700' }]} />
<script is:inline>
  // Loading a page never smooth-scrolls (the page's smooth scrolling is for in-page links), and a
  // reload starts at the top, as the prototype did, instead of scrolling back down the page.
  (function () {
    var r = document.documentElement;
    r.style.scrollBehavior = 'auto';
    document.addEventListener('DOMContentLoaded', function () { requestAnimationFrame(function () { r.style.scrollBehavior = ''; }); });
    try {
      var n = performance.getEntriesByType('navigation')[0];
      if (n && n.type === 'reload' && !location.hash) {
        history.scrollRestoration = 'manual';
        if (history.state) history.replaceState(Object.assign({}, history.state, { scrollX: 0, scrollY: 0 }), '');
      }
    } catch (e) {}
  })();
</script>
<script is:inline>
  // Pages swap under the ring wipe at 480ms, as in the prototype. Hide the browser's own view
  // transition from the router so it swaps straight away, instead of first freezing the page to
  // snapshot it (which only delays the swap and stalls the wipe on slower devices).
  try { Object.defineProperty(document, 'startViewTransition', { value: undefined }); } catch (e) {}
</script>
<ClientRouter fallback="swap" />
</head>
<body data-page={page}>
<a class="skip btn btn-red" href="#main">Skip to content</a>
<Sprite />
<Header current={page} />

<main id="main" tabindex="-1">
<slot />
</main>

<Footer />
<div class="mbar" id="mbar" role="region" aria-label="Quick actions" transition:persist="mbar"><button class="btn btn-red go" id="mbarGo">Request a sample</button><a href={WHATSAPP_URL} target="_blank" rel="noopener" class="btn btn-line">WhatsApp</a></div>
<div class="wipe" id="wipe" aria-hidden="true" transition:persist="wipe"><svg class="wipe-ring" viewBox="0 0 100 100"><circle cx="50" cy="50" r="44" pathLength="100"/></svg><svg class="wipe-mark" viewBox="0 0 256.86 262.30"><use href="#fc-mark"/></svg></div>
<div class="c-ring" id="cRing" hidden transition:persist="c-ring"></div><div class="c-dot" id="cDot" hidden transition:persist="c-dot"></div>
<div class="toast" id="toast" role="status" aria-live="polite" transition:persist="toast"></div>
<script>
  import '../scripts/main';
</script>
</body>
</html>
